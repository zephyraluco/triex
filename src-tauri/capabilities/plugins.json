{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugins",
  "description": "Sandboxed IPC capabilities for embedded and detached plugin webviews",
  "windows": ["main", "plugin-detached-*"],
  "webviews": ["plugin-*"],
  "remote": {
    "urls": ["http://plugin.localhost/*", "plugin://*"]
  },
  "permissions": ["core:default"]
}
